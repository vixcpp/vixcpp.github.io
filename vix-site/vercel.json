{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/docs/?$",
      "status": 308,
      "headers": {
        "Location": "https://docs.vixcpp.com"
      }
    },
    {
      "src": "/docs/(.*)",
      "status": 308,
      "headers": {
        "Location": "https://docs.vixcpp.com/$1"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
